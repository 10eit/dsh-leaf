{
  "name": "dsh-leaf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LaTeX submission workspace for DeepSeek Harness: project file tree, source editor, compile pipeline, and paper PDF preview.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "tools/*.swift",
    "assets/*.png",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js && node --check lib/paths.js && node --check lib/project.js && node --check lib/tex.js && node --check lib/routes.js && node --check lib/tool.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10eit/dsh-leaf.git"
  },
  "homepage": "https://github.com/10eit/dsh-leaf#readme",
  "bugs": {
    "url": "https://github.com/10eit/dsh-leaf/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  }
}
